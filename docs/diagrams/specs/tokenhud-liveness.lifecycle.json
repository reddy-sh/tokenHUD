{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Host Liveness and Endings",
    "quality_profile": "showcase",
    "viewBox": [
      1300,
      630
    ],
    "views": [
      {
        "id": "liveness-rail",
        "label": "The liveness rail",
        "focus": [
          "first",
          "up",
          "stale",
          "down"
        ],
        "note": "Up, stale and down describe the agent checking in — not whether the machine is on."
      },
      {
        "id": "recovery",
        "label": "Nothing is terminal",
        "focus": [
          "stale",
          "down",
          "up"
        ],
        "note": "A reading landing flips stale back to up; a returning agent revives a down host."
      },
      {
        "id": "endings-path",
        "label": "How endings appear",
        "focus": [
          "up",
          "diff",
          "ended_tight",
          "ended_wide"
        ],
        "note": "Running in one reading and gone from the next means ended — with both timestamps kept."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Host liveness"
    },
    {
      "id": "events",
      "label": "Reading diffs"
    },
    {
      "id": "terminal",
      "label": "Endings"
    }
  ],
  "states": [
    {
      "id": "first",
      "type": "start",
      "label": "First reading",
      "sublabel": "host appears on the board",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "up",
      "type": "active",
      "label": "Up",
      "sublabel": "checked in within 2 min",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "live"
    },
    {
      "id": "stale",
      "type": "waiting",
      "label": "Stale",
      "sublabel": "silent for 2–15 min",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "down",
      "type": "failure",
      "label": "Down",
      "sublabel": "silent past 15 min",
      "lane": "main",
      "col": 3,
      "tag": "recoverable"
    },
    {
      "id": "diff",
      "type": "decision",
      "label": "Diff readings",
      "sublabel": "ran in one, gone from next?",
      "lane": "events",
      "col": 0
    },
    {
      "id": "ended_tight",
      "type": "success",
      "label": "Ended · tight",
      "sublabel": "inside one ~30 s interval",
      "lane": "terminal",
      "col": 0
    },
    {
      "id": "ended_wide",
      "type": "neutral",
      "label": "Ended · range",
      "sublabel": "\"between 09:14 and 13:20\"",
      "lane": "terminal",
      "col": 1
    }
  ],
  "transitions": [
    {
      "from": "stale",
      "to": "up",
      "label": "reading lands",
      "variant": "emphasis",
      "route": "top-channel"
    },
    {
      "from": "down",
      "to": "up",
      "label": "agent checks in again",
      "variant": "emphasis",
      "route": "top-channel",
      "labelDx": 120
    },
    {
      "from": "up",
      "to": "diff",
      "label": "each new reading",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    },
    {
      "from": "diff",
      "to": "ended_tight",
      "label": "absent now",
      "variant": "default",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24,
      "labelDx": -45
    },
    {
      "from": "diff",
      "to": "ended_wide",
      "label": "absent after a sleep",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "About the Agent, Not the Machine",
      "items": [
        "Up means the agent checked in within 2 minutes; stale runs to 15; down is after — a distinction the board keeps deliberately",
        "The board schedules reads from intervalSeconds carried in every snapshot, not from a guessed poll rate"
      ]
    },
    {
      "dot": "amber",
      "title": "Endings Are Diffs",
      "items": [
        "Nobody watches a dashboard at every instant — the question is what finished",
        "Anything running in one reading and gone from the next is recorded with both timestamps",
        "A 30-second cadence yields a tight window; a laptop that slept yields an honest range, never a precise guess"
      ]
    },
    {
      "dot": "rose",
      "title": "Honest Absences",
      "items": [
        "Endings can only exist from the moment the server starts watching, and the panel says so",
        "Down is recoverable by construction — the next check-in flips the host back to up",
        "\"The disk collector is down\" and \"the host is down\" stay different facts"
      ]
    }
  ]
}
