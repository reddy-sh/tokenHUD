    { "dot": "rose", "title": "One Key, One Direction", "items": ["Writes require X-TokenHUD-Key, compared with a constant-time digest", "Reads are open by default; TOKENHUD_PROTECT_READS=1 closes them", "On loopback the key is ceremony; beyond loopback it is a real credential behind TLS"] },
    { "dot": "cyan", "title": "Whole State Every Event", "items": ["Each SSE event carries the entire overview — a missed event never causes drift", "gzip with a sync flush keeps the stream as cheap as the polls it replaced", "A reconnect is a resync, not a gap to reconcile"] },
