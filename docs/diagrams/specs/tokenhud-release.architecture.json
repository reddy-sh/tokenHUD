  "cards": [
    {
      "dot": "emerald",
      "title": "Nothing To Install Beside Them",
      "items": [
        "Two static binaries, about 4 MB together - no interpreter, no package manager",
        "install.sh detects OS and architecture from uname: macOS and Linux, x86_64 and arm64",
        "An unsupported OS exits with a message rather than misbehaving - Windows means WSL2 today"
      ]
    },
    {
      "dot": "cyan",
      "title": "Checksummed and Verified",
      "items": [
        "Every release asset ships with its own .sha256 beside it",
        "The latest tag is resolved from the GitHub API, never hard-coded",
        "Each installed binary is exercised with --version before install.sh reports ok"
      ]
    },
    {
      "dot": "amber",
      "title": "CI Treats the Dependency List as a Test",
      "items": [
        "Every push runs fmt, clippy -D warnings, and tests with --nocapture so machine-dependent skips stay visible",
        "cargo tree --depth 1 is printed in each job - a new dependency must be noticed in review, not discovered later"
      ]
    }
  ]
