    { "dot": "rose", "title": "Privacy Boundary", "items": ["Prompt and completion text are never read into the payload — no code path collects them", "Consent is recorded against a SHA-256 digest of the read manifest; a release that reads more asks again", "Three tests hold the manifest to the code: undeclared paths fail the build"] },
    { "dot": "cyan", "title": "Push, Not Poll", "items": ["Every SSE event carries the whole overview, so a missed event never leaves a reader behind", "Polling stays as the fallback when EventSource is absent or the stream errors", "Freshness is bounded by TOKENHUD_INTERVAL — how often the agent looks"] },
