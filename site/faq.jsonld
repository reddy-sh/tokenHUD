{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://tokenhud.com/#faq",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I see how many tokens Claude Code is using?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TokenHUD meters Claude Code's token usage live on your own machine. It reads Claude Code's local session transcripts and reports input, output and cache tokens per session, model, and project, plus your plan's five-hour and seven-day usage windows and when they reset."
      }
    },
    {
      "@type": "Question",
      "name": "Does TokenHUD see my prompts or my code?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Prompt text, completion text, source code and tool-call arguments are never read into the payload at all — not filtered out afterwards. The transcript parser reads only the numeric usage fields from assistant records. There is no code path that collects content, so no configuration mistake can expose it."
      }
    },
    {
      "@type": "Question",
      "name": "Is TokenHUD free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, free forever for one developer on one machine, with unlimited metering and no sampling. A paid per-seat team tier adds cross-machine rollups, shared budgets, retained history and chargeback reports. The free tier is not degraded to drive upgrades — the upgrade trigger is a second person needing the same numbers."
      }
    },
    {
      "@type": "Question",
      "name": "Does TokenHUD work offline?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The free tier runs entirely on your machine and sends nothing anywhere. The agent, the server and the dashboard all run on localhost, so it works with the network off."
      }
    },
    {
      "@type": "Question",
      "name": "Will TokenHUD slow down my machine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. A collection cycle takes about 0.06 seconds in steady state. The agent indexes a transcript corpus incrementally by byte offset, so after the first pass it reads only what was appended — a few kilobytes per cycle rather than re-reading a gigabyte."
      }
    },
    {
      "@type": "Question",
      "name": "Which AI coding agents does TokenHUD support?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Claude Code today. TokenHUD also detects Codex CLI, Cursor, Gemini CLI, Windsurf and other assistants installed on the machine and lists them, marking the ones no collector reads yet rather than showing an empty dashboard."
      }
    },
    {
      "@type": "Question",
      "name": "How do I track the cost of my AI coding agents?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TokenHUD prices your measured token usage at published API list rates and shows estimated value per session, per model and per day. On a subscription plan the CLI reports $0 per request because the plan is a flat fee, so the figure is labelled an estimate everywhere it appears — a yardstick for comparing sessions, not a bill."
      }
    },
    {
      "@type": "Question",
      "name": "When does my Claude usage limit reset?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TokenHUD reads the real five-hour and seven-day window state that Claude Code caches locally and shows the percentage used with a live countdown to each reset. If that cache is more than an hour old the percentages grey out and are marked stale, while the countdowns stay exact, because a reset instant is absolute."
      }
    },
    {
      "@type": "Question",
      "name": "Can I monitor MCP servers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MCP server discovery and health is on the roadmap and not yet built. TokenHUD today discovers and reports Claude Code agent processes on the host."
      }
    },
    {
      "@type": "Question",
      "name": "What does TokenHUD install?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Two static binaries, about 4 MB together. No interpreter, no npx, no pip, no package manager. The dashboard is a single self-contained HTML file with no CDN reference — a test in the repository fails the build if any external reference appears in it."
      }
    },
    {
      "@type": "Question",
      "name": "Is TokenHUD open source?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, MIT licensed, at github.com/reddy-sh/tokenhud. The agent, server and dashboard are all in the repository and it ships a self-test that runs the real collectors against your machine with nothing mocked."
      }
    }
  ]
}
