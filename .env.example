# Copy to .env (which is gitignored) and fill in.
# Generate the key with:  python3 server/server.py --new-key
TOKENHUD_KEY=
TOKENHUD_SERVER=http://127.0.0.1:8787
TOKENHUD_INTERVAL=30

# Optional
# TOKENHUD_HOST=my-laptop          # override the reported machine name
# TOKENHUD_BIND=127.0.0.1          # 0.0.0.0 exposes the server — read the README
# TOKENHUD_PORT=8787
# TOKENHUD_RETENTION_DAYS=30
# TOKENHUD_PROTECT_READS=1         # require the key on GET too
# TOKENHUD_SEND_PROMPTS=1          # opt in to shipping prompt text and session
#                              # titles (which are written from prompts).
# TOKENHUD_SCAN_BUDGET_MB=512      # transcript bytes read per cycle; the first
#                              # pass over a big corpus takes a few cycles.
# TOKENHUD_STATE=~/.tokenhud           # where the spool and transcript index live
