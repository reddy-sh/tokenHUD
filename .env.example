# Copy to .env (which is gitignored) and fill in.
# Generate the key with:  python3 server/server.py --new-key
AIMC_KEY=
AIMC_SERVER=http://127.0.0.1:8787
AIMC_INTERVAL=30

# Optional
# AIMC_HOST=my-laptop          # override the reported machine name
# AIMC_BIND=127.0.0.1          # 0.0.0.0 exposes the server — read the README
# AIMC_PORT=8787
# AIMC_RETENTION_DAYS=30
# AIMC_PROTECT_READS=1         # require the key on GET too
# AIMC_SEND_PROMPTS=1          # opt in to shipping prompt text. Off by default.
